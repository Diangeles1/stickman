{
  "name": "stickman-fight-engine",
  "version": "1.0.0",
  "description": "STICKMAN FIGHT ENGINE - motor reutilizavel de animacao de lutas para video vertical",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.527",
    "@remotion/three": "4.0.527",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.527",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.527",
    "@types/react": "19.2.7",
    "@types/three": "0.186.0",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "node scripts/remotion.mjs studio",
    "studio": "node scripts/remotion.mjs studio",
    "build": "remotion bundle",
    "render": "node scripts/remotion.mjs render Prototype out/prototype.mp4",
    "render:still": "node scripts/remotion.mjs still Prototype out/frame.png",
    "compositions": "node scripts/remotion.mjs compositions",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc --noEmit",
    "upgrade": "remotion upgrade",
    "canal": "python3 scripts/preparar-marca.py",
    "canal:desenhado": "node scripts/remotion.mjs still Banner out/canal/Banner.png && node scripts/remotion.mjs still Avatar out/canal/Avatar.png && node scripts/remotion.mjs still CapaDoVideo out/canal/Capa.png",
    "canal:youtube": "node scripts/canal-youtube.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
